# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mytraders:mytraders@localhost:5432/mytraders_dev?schema=public

# Long random string (min 32 chars). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Browser origin allowed by CORS (the Vite dev server proxies /api, so this is a fallback).
CORS_ORIGIN=http://localhost:5173
# Secure cookies require HTTPS; keep false for plain http://localhost development.
COOKIE_SECURE=false

LOG_LEVEL=info
# Login attempts per IP per minute.
LOGIN_RATE_LIMIT=10
# Which proxies may set X-Forwarded-For: loopback (reverse proxy on this host), a hop count
# (1 behind one load balancer), proxy IPs / CIDRs, or false. Never "true" in production.
TRUST_PROXY=loopback
