// Source of truth for the design: docs/database-design.md
// Phase 1 contains only the platform foundation tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ORDER_BOOKER
}

/// Unit of a product's weight value (docs D-22, D-26).
enum ProductUnit {
  KG
  GRAM
  LITER
  ML
}

/// How a product is invoiced (D-26): TIN by pieces, POUCH by cartons.
enum ProductType {
  TIN
  POUCH
}

/// What a product's weight refers to.
enum WeightBasis {
  PIECE
  CARTON
}

enum OrderStatus {
  PENDING
  INVOICED
  CANCELLED
}

enum CounterKey {
  ORDER
  INVOICE
}

model Organization {
  id                  String             @id @default(uuid(7)) @db.Uuid
  name                String
  status              OrganizationStatus @default(TRIAL)
  // settings (1:1, kept on the row for simplicity)
  address             String?
  town                String?
  phone               String?
  ntn                 String?
  strn                String?
  logoUrl             String?
  currency            String             @default("PKR") @db.Char(3)
  timezone            String             @default("Asia/Karachi")
  invoicePrefix       String             @default("INV-")
  invoiceNumberDigits Int                @default(6)
  orderPrefix         String             @default("ORD-")
  orderNumberDigits   Int                @default(6)
  defaultTaxRate      Decimal            @default(0) @db.Decimal(7, 4)
  createdAt           DateTime           @default(now()) @db.Timestamptz
  updatedAt           DateTime           @updatedAt @db.Timestamptz

  users          User[]
  counters       OrganizationCounter[]
  areas          Area[]
  shopCategories ShopCategory[]
  products       Product[]
  shops          Shop[]
  orders         Order[]
}

/// organizationId is null only for SUPER_ADMIN (enforced by a CHECK constraint in the migration).
model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String?   @db.Uuid
  /// stored lower-cased; globally unique (login needs no company code)
  email          String    @unique
  passwordHash   String
  name           String
  phone          String?
  role           UserRole
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refreshTokens   RefreshToken[]
  assignedShops   Shop[]
  bookedOrders    Order[]        @relation("BookedOrders")
  cancelledOrders Order[]        @relation("CancelledOrders")

  @@index([organizationId, role])
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  /// sha256 of the opaque token; the raw token is never stored
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz
  revokedAt    DateTime? @db.Timestamptz
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OrganizationCounter {
  organizationId String     @db.Uuid
  key            CounterKey
  nextValue      Int        @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
}

/// Market area (e.g. Saddar). Name unique per organization, case/space-insensitive via nameNormalized.
model Area {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// display name, trimmed with single spaces
  name           String
  /// lower-cased name used for uniqueness (set by the service)
  nameNormalized String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shops        Shop[]

  @@unique([organizationId, nameNormalized])
}

/// Shop type used to group shops (e.g. Convenience Store, Wholesale). Printed as "Channel" on invoices.
/// Name unique per organization, case/space-insensitive via nameNormalized.
model ShopCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// display name, trimmed with single spaces
  name           String
  /// lower-cased name used for uniqueness (set by the service)
  nameNormalized String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shops        Shop[]

  @@unique([organizationId, nameNormalized])
}

/// Product master (defaults only — invoices snapshot the values actually used). Invoice rules (D-26):
/// TIN is invoiced by pieces, POUCH by cartons (pieces = cartons × piecesPerCarton, display only);
/// tradePrice drives the invoice value, invoiceCostPrice is for profit only, retailPrice is display
/// only, defaultTaxRate is the starting rate the invoice snapshots.
model Product {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @db.Uuid
  /// display name, trimmed with single spaces
  name             String
  code             String?
  /// lower-cased code used for per-organization uniqueness (set by the service)
  codeNormalized   String?
  type             ProductType
  /// display only, never used in calculations
  rateCode         String?
  /// R.P — display / reference only
  retailPrice      Decimal      @db.Decimal(14, 2)
  /// T.P — drives the invoice value
  tradePrice       Decimal      @db.Decimal(14, 2)
  /// what the distributor pays the company — profit only
  invoiceCostPrice Decimal      @db.Decimal(14, 2)
  /// percent; default for new invoice lines (never hard-coded)
  defaultTaxRate   Decimal      @db.Decimal(7, 4)
  /// expressed in `weightUnit`, per `weightBasis`
  weight           Decimal?     @db.Decimal(12, 3)
  weightUnit       ProductUnit?
  weightBasis      WeightBasis?
  /// required for POUCH (CHECK constraint)
  piecesPerCarton  Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]

  @@unique([organizationId, codeNormalized])
  @@index([organizationId, name])
}

/// Customer shop. Area/category/booker are validated inside the same organization by the service
/// (docs D-23). There is deliberately NO credit/balance column: the outstanding balance will
/// always be computed from ledger entries (Phase 5).
model Shop {
  id                    String   @id @default(uuid(7)) @db.Uuid
  organizationId        String   @db.Uuid
  /// display name, trimmed with single spaces; not unique
  name                  String
  /// owner / contact person
  contactPerson         String?
  phone                 String?
  address               String?
  ntn                   String?
  strn                  String?
  cnic                  String?
  areaId                String   @db.Uuid
  categoryId            String?  @db.Uuid
  assignedOrderBookerId String?  @db.Uuid
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area                Area          @relation(fields: [areaId], references: [id], onDelete: Restrict)
  category            ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedOrderBooker User?         @relation(fields: [assignedOrderBookerId], references: [id], onDelete: Restrict)
  orders              Order[]

  @@index([organizationId, name])
  @@index([organizationId, areaId])
  @@index([organizationId, categoryId])
  /// used by the Order Booker "My Shops" list (Phase 3)
  @@index([organizationId, assignedOrderBookerId])
}

/// Order booked by an Order Booker in the market (docs §4.8, D-25). Products and quantities only:
/// prices, tax and payment are decided later on the invoice.
model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  /// organization order prefix + zero-padded counter; generated by the server
  orderNumber    String
  shopId         String      @db.Uuid
  /// always the signed-in Order Booker who created it
  orderBookerId  String      @db.Uuid
  status         OrderStatus @default(PENDING)
  notes          String?
  cancelledAt    DateTime?   @db.Timestamptz
  cancelledById  String?     @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderBooker  User         @relation("BookedOrders", fields: [orderBookerId], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("CancelledOrders", fields: [cancelledById], references: [id], onDelete: Restrict)
  items        OrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, orderBookerId, createdAt])
  @@index([organizationId, shopId])
}

/// One product line of an order. Reached only through its Order (not a tenant model itself).
model OrderItem {
  id        String @id @default(uuid(7)) @db.Uuid
  orderId   String @db.Uuid
  productId String @db.Uuid
  /// whole units as added by the Admin, e.g. cartons (D-15, D-25)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}
