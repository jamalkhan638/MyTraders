// Source of truth for the design: docs/database-design.md
// Phase 1 contains only the platform foundation tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ORDER_BOOKER
}

/// Unit of a product's weight value (docs D-22, D-26).
enum ProductUnit {
  KG
  GRAM
  LITER
  ML
}

/// How a product is invoiced (D-26): TIN by pieces, POUCH by cartons.
enum ProductType {
  TIN
  POUCH
}

/// What an order quantity counts (D-28)
enum QuantityUnit {
  PIECE
  CARTON
}

/// What a shop ledger entry records (D-30). Debit = the shop owes more; credit = owes less.
enum LedgerEntryType {
  /// debit: a confirmed invoice (its Grand Total)
  INVOICE
  /// credit: money received from the shop
  PAYMENT
  /// debit (increase) or credit (decrease): an Admin correction with a reason
  MANUAL_ADJUSTMENT
  /// credit: reverses a cancelled invoice's debit, exact same amount
  INVOICE_REVERSAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

/// An expense counts in totals while ACTIVE; a VOIDED expense keeps its history but counts nowhere.
enum ExpenseStatus {
  ACTIVE
  VOIDED
}

/// What a product's weight refers to.
enum InvoiceStatus {
  CONFIRMED
  CANCELLED
}

/// Unit of an invoice row's Total Weight: KG (KG / Gram products) or Liter (Liter / ML products)
enum TotalWeightUnit {
  KG
  LITER
}

enum WeightBasis {
  PIECE
  CARTON
}

enum OrderStatus {
  PENDING
  INVOICED
  CANCELLED
}

enum CounterKey {
  ORDER
  INVOICE
}

model Organization {
  id                  String             @id @default(uuid(7)) @db.Uuid
  name                String
  status              OrganizationStatus @default(TRIAL)
  // settings (1:1, kept on the row for simplicity)
  address             String?
  town                String?
  phone               String?
  ntn                 String?
  strn                String?
  logoUrl             String?
  currency            String             @default("PKR") @db.Char(3)
  timezone            String             @default("Asia/Karachi")
  invoicePrefix       String             @default("INV-")
  invoiceNumberDigits Int                @default(6)
  orderPrefix         String             @default("ORD-")
  orderNumberDigits   Int                @default(6)
  defaultTaxRate      Decimal            @default(0) @db.Decimal(7, 4)
  /// last activate / suspend by a Super Admin (platform tenant management, D-38)
  statusChangedAt     DateTime?          @db.Timestamptz
  statusChangedById   String?            @db.Uuid
  /// why the tenant was suspended; cleared on reactivation
  suspensionReason    String?
  createdAt           DateTime           @default(now()) @db.Timestamptz
  updatedAt           DateTime           @updatedAt @db.Timestamptz

  statusChangedBy   User?                 @relation("OrganizationStatusChanges", fields: [statusChangedById], references: [id], onDelete: Restrict)
  users             User[]
  counters          OrganizationCounter[]
  areas             Area[]
  shopCategories    ShopCategory[]
  products          Product[]
  shops             Shop[]
  orders            Order[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
  ledgerEntries     ShopLedgerEntry[]
  payments          Payment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
}

/// organizationId is null only for SUPER_ADMIN (enforced by a CHECK constraint in the migration).
model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String?   @db.Uuid
  /// stored lower-cased; globally unique (login needs no company code)
  email          String    @unique
  passwordHash   String
  name           String
  phone          String?
  role           UserRole
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  organization              Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refreshTokens             RefreshToken[]
  assignedShops             Shop[]
  bookedOrders              Order[]           @relation("BookedOrders")
  cancelledOrders           Order[]           @relation("CancelledOrders")
  createdInvoices           Invoice[]         @relation("CreatedInvoices")
  cancelledInvoices         Invoice[]         @relation("CancelledInvoices")
  ledgerEntries             ShopLedgerEntry[]
  payments                  Payment[]
  createdExpenses           Expense[]         @relation("CreatedExpenses")
  updatedExpenses           Expense[]         @relation("UpdatedExpenses")
  voidedExpenses            Expense[]         @relation("VoidedExpenses")
  /// tenants whose status this Super Admin changed
  organizationStatusChanges Organization[]    @relation("OrganizationStatusChanges")

  @@index([organizationId, role])
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  /// sha256 of the opaque token; the raw token is never stored
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz
  revokedAt    DateTime? @db.Timestamptz
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OrganizationCounter {
  organizationId String     @db.Uuid
  key            CounterKey
  nextValue      Int        @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
}

/// Market area (e.g. Saddar). Name unique per organization, case/space-insensitive via nameNormalized.
model Area {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// display name, trimmed with single spaces
  name           String
  /// lower-cased name used for uniqueness (set by the service)
  nameNormalized String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shops        Shop[]
  /// invoices whose shop was in this area when they were confirmed (historical reporting)
  invoices     Invoice[]

  @@unique([organizationId, nameNormalized])
}

/// Shop type used to group shops (e.g. Convenience Store, Wholesale). Printed as "Channel" on invoices.
/// Name unique per organization, case/space-insensitive via nameNormalized.
model ShopCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// display name, trimmed with single spaces
  name           String
  /// lower-cased name used for uniqueness (set by the service)
  nameNormalized String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shops        Shop[]

  @@unique([organizationId, nameNormalized])
}

/// Product master (defaults only — invoices snapshot the values actually used). Invoice rules (D-26):
/// TIN is invoiced by pieces, POUCH by cartons (pieces = cartons × piecesPerCarton, display only);
/// tradePrice drives the invoice value, invoiceCostPrice is for profit only, retailPrice is display
/// only, defaultTaxRate is the starting rate the invoice snapshots.
model Product {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @db.Uuid
  /// display name, trimmed with single spaces
  name             String
  code             String?
  /// lower-cased code used for per-organization uniqueness (set by the service)
  codeNormalized   String?
  type             ProductType
  /// display only, never used in calculations
  /// R.P — display / reference only
  retailPrice      Decimal      @db.Decimal(14, 2)
  /// T.P — drives the invoice value
  tradePrice       Decimal      @db.Decimal(14, 2)
  /// what the distributor pays the company — profit only
  invoiceCostPrice Decimal      @db.Decimal(14, 2)
  /// percent; default for new invoice lines (never hard-coded)
  defaultTaxRate   Decimal      @db.Decimal(7, 4)
  /// expressed in `weightUnit`, per `weightBasis`
  weight           Decimal?     @db.Decimal(12, 3)
  weightUnit       ProductUnit?
  weightBasis      WeightBasis?
  /// required for POUCH (CHECK constraint)
  piecesPerCarton  Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]

  @@unique([organizationId, codeNormalized])
  @@index([organizationId, name])
}

/// Customer shop. Area/category/booker are validated inside the same organization by the service
/// (docs D-23). There is deliberately NO credit/balance column: the outstanding balance will
/// always be computed from ledger entries (Phase 5).
model Shop {
  id                    String   @id @default(uuid(7)) @db.Uuid
  organizationId        String   @db.Uuid
  /// display name, trimmed with single spaces; not unique
  name                  String
  /// owner / contact person
  contactPerson         String?
  phone                 String?
  address               String?
  ntn                   String?
  strn                  String?
  cnic                  String?
  areaId                String   @db.Uuid
  categoryId            String?  @db.Uuid
  assignedOrderBookerId String?  @db.Uuid
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area                Area              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  category            ShopCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedOrderBooker User?             @relation(fields: [assignedOrderBookerId], references: [id], onDelete: Restrict)
  orders              Order[]
  invoices            Invoice[]
  ledgerEntries       ShopLedgerEntry[]
  payments            Payment[]

  @@index([organizationId, name])
  @@index([organizationId, areaId])
  @@index([organizationId, categoryId])
  /// used by the Order Booker "My Shops" list (Phase 3)
  @@index([organizationId, assignedOrderBookerId])
}

/// Order booked by an Order Booker in the market (docs §4.8, D-25). Products and quantities only:
/// prices, tax and payment are decided later on the invoice.
model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  /// organization order prefix + zero-padded counter; generated by the server
  orderNumber    String
  shopId         String      @db.Uuid
  /// always the signed-in Order Booker who created it
  orderBookerId  String      @db.Uuid
  status         OrderStatus @default(PENDING)
  notes          String?
  cancelledAt    DateTime?   @db.Timestamptz
  cancelledById  String?     @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderBooker  User         @relation("BookedOrders", fields: [orderBookerId], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("CancelledOrders", fields: [cancelledById], references: [id], onDelete: Restrict)
  items        OrderItem[]
  invoice      Invoice?

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, orderBookerId, createdAt])
  @@index([organizationId, shopId])
}

/// One product line of an order. Reached only through its Order (not a tenant model itself).
model OrderItem {
  id           String       @id @default(uuid(7)) @db.Uuid
  orderId      String       @db.Uuid
  productId    String       @db.Uuid
  /// whole number in `quantityUnit` (D-25, D-28)
  quantity     Int
  /// PIECE for a TIN, CARTON for a POUCH; set by the server from the product type when booked
  quantityUnit QuantityUnit

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

/// A confirmed sale invoice (docs/invoice-specification.md, D-29). Append-only: every value needed
/// to print it again is snapshotted here or on its items; only cancellation changes the row.
model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  /// organization invoice prefix + zero-padded counter; generated by the server on confirm
  invoiceNumber  String
  invoiceDate    DateTime      @db.Date
  shopId         String        @db.Uuid
  /// the PENDING order this invoice was generated from; an order is invoiced at most once
  orderId        String?       @unique @db.Uuid
  status         InvoiceStatus @default(CONFIRMED)

  // shop as printed ("Shop information"), snapshotted on confirm
  shopName          String
  shopAddress       String?
  shopPhone         String?
  shopContactPerson String?
  shopNtn           String?
  shopStrn          String?
  shopCnic          String?
  /// shop category, printed as "Channel"
  shopCategory      String?
  shopArea          String
  /// the shop's area when the invoice was confirmed — historical sales reports filter / group by
  /// this, so moving a shop to another area later never moves its old invoices (D-37)
  shopAreaId        String  @db.Uuid

  // distributor as printed ("Distributor information"), snapshotted on confirm
  distributorName    String
  distributorAddress String?
  distributorTown    String?
  distributorPhone   String?
  distributorNtn     String?
  distributorStrn    String?
  currency           String  @db.Char(3)

  // totals, computed by the server (Σ of the items)
  totalValueExclTax Decimal @db.Decimal(14, 2)
  totalGstAmount    Decimal @db.Decimal(14, 2)
  totalValueInclGst Decimal @db.Decimal(14, 2)
  totalTradeOffer   Decimal @db.Decimal(14, 2)
  /// Σ Gross Invoice Value of the items
  grandTotal        Decimal @db.Decimal(14, 2)
  /// Σ item cost (invoice/cost price) — profit only, never printed
  totalCost         Decimal @db.Decimal(14, 2)

  // optional Admin entries, no formula; null = not printed
  advanceTax   Decimal? @db.Decimal(14, 2)
  furtherTax   Decimal? @db.Decimal(14, 2)
  /// ADT / invoice-level special discount (separate from the line Special Discount)
  adtDiscount  Decimal? @db.Decimal(14, 2)
  /// shop's previous outstanding balance as printed; editing it never touches the ledger
  duePayment   Decimal? @db.Decimal(14, 2)
  /// Grand Total + Advance Tax + Further Tax − ADT discount; the amount debited to the ledger (D-31)
  payableValue Decimal  @db.Decimal(14, 2)
  notes        String?

  createdById   String    @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  area          Area              @relation(fields: [shopAreaId], references: [id], onDelete: Restrict)
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy   User?             @relation("CancelledInvoices", fields: [cancelledById], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  ledgerEntries ShopLedgerEntry[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, shopId, invoiceDate])
  @@index([organizationId, status, invoiceDate])
  @@index([organizationId, shopAreaId, invoiceDate])
}

/// One row of an invoice: the product as it was, the quantities and every calculated value.
model InvoiceItem {
  id             String @id @default(uuid(7)) @db.Uuid
  /// denormalized for tenant-scoped reporting
  organizationId String @db.Uuid
  invoiceId      String @db.Uuid
  lineNo         Int
  productId      String @db.Uuid

  // product snapshot
  productCode      String?
  productName      String
  productType      ProductType
  retailPrice      Decimal      @db.Decimal(14, 2)
  tradePrice       Decimal      @db.Decimal(14, 2)
  invoiceCostPrice Decimal      @db.Decimal(14, 2)
  piecesPerCarton  Int?
  weight           Decimal?     @db.Decimal(12, 3)
  weightUnit       ProductUnit?
  weightBasis      WeightBasis?

  // quantities: TIN prices Qty Pcs (Qty Ctn null); POUCH prices Qty Ctn (Qty Pcs display only)
  qtyCtn          Int?
  qtyPcs          Int?
  totalWeight     Decimal          @db.Decimal(14, 3)
  totalWeightUnit TotalWeightUnit?

  // values
  gstRate         Decimal @db.Decimal(7, 4)
  valueExclTax    Decimal @db.Decimal(14, 2)
  gstAmount       Decimal @db.Decimal(14, 2)
  valueInclGst    Decimal @db.Decimal(14, 2)
  toRate          Decimal @db.Decimal(14, 4)
  toAmount        Decimal @db.Decimal(14, 2)
  atoRate         Decimal @db.Decimal(14, 4)
  atoAmount       Decimal @db.Decimal(14, 2)
  specialDiscount Decimal @db.Decimal(14, 2)
  totalTradeOffer Decimal @db.Decimal(14, 2)
  grossValue      Decimal @db.Decimal(14, 2)
  /// pricing quantity × invoice/cost price — profit only
  costTotal       Decimal @db.Decimal(14, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@index([organizationId, productId])
}

/// Money received from a shop. Every payment has exactly one PAYMENT ledger credit. Append-only.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  shopId         String        @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  paymentDate    DateTime      @db.Date
  method         PaymentMethod @default(CASH)
  /// receipt / cheque / transfer reference
  reference      String?
  notes          String?
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  ledgerEntry  ShopLedgerEntry?

  @@index([organizationId, shopId, paymentDate])
  @@index([organizationId, paymentDate])
}

/// The single source of truth for shop credit (D-30). Balance = Σ debitAmount − Σ creditAmount.
/// Append-only; exactly one of debitAmount / creditAmount is > 0.
model ShopLedgerEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @db.Uuid
  shopId          String          @db.Uuid
  type            LedgerEntryType
  debitAmount     Decimal         @default(0) @db.Decimal(14, 2)
  creditAmount    Decimal         @default(0) @db.Decimal(14, 2)
  /// business date (organization timezone); running balances order by (transactionDate, createdAt, id)
  transactionDate DateTime        @db.Date
  invoiceId       String?         @db.Uuid
  /// set for PAYMENT entries; one entry per payment
  paymentId       String?         @unique @db.Uuid
  notes           String?
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  /// one INVOICE debit and at most one INVOICE_REVERSAL per invoice
  @@unique([invoiceId, type])
  @@index([organizationId, shopId, transactionDate, createdAt, id])
  @@index([organizationId, type, transactionDate])
}

/// Expense categories of an organization (Fuel, Salary, Rent…). Never deleted — deactivated.
model ExpenseCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// display name, trimmed with single spaces
  name           String
  /// lower-cased name used for uniqueness (set by the service)
  nameNormalized String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@unique([organizationId, nameNormalized])
}

/// A business expense recorded by an Admin (D-32). Editable while ACTIVE; never deleted — voided
/// with a reason instead. Only ACTIVE expenses count in totals (and later in Net Profit).
model Expense {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  categoryId     String        @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  /// business date (organization timezone); never in the future
  expenseDate    DateTime      @db.Date
  description    String?
  /// bill / voucher / receipt number
  reference      String?
  status         ExpenseStatus @default(ACTIVE)
  createdById    String        @db.Uuid
  updatedById    String?       @db.Uuid
  voidedAt       DateTime?     @db.Timestamptz
  voidedById     String?       @db.Uuid
  voidReason     String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy    User            @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?           @relation("UpdatedExpenses", fields: [updatedById], references: [id], onDelete: Restrict)
  voidedBy     User?           @relation("VoidedExpenses", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expenseDate])
  @@index([organizationId, categoryId, expenseDate])
}
