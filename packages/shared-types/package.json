{
  "name": "@mytraders/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "API contracts (zod schemas), enums and pure calculators shared by web and api.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mytraders/config": "workspace:*",
    "eslint": "^9.39.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
